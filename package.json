{
  "name": "radial-file-studio",
  "version": "0.3.0",
  "description": "Windows-first floating glassmorphic radial desktop converter and local file manager",
  "main": "dist-electron/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && node -e \"import('fs').then(fs => fs.copyFileSync('node_modules/sql.js/dist/sql-wasm.wasm', 'dist-electron/main/sql-wasm.wasm'))\"",
    "build:icons": "node scripts/generate-icons.js",
    "preview": "vite preview",
    "test": "vitest run",
    "package:win": "npm run build && electron-builder --win --x64",
    "package:portable": "npm run build && electron-builder --win portable --x64",
    "package:all": "npm run build && electron-builder --win nsis portable --x64"
  },
  "keywords": [
    "windows",
    "electron",
    "radial-menu",
    "file-converter",
    "glassmorphism",
    "desktop-widget"
  ],
  "author": "Vincent",
  "license": "MIT",
  "dependencies": {
    "@types/sharp": "^0.31.1",
    "bmp-js": "^0.1.0",
    "lucide-react": "^0.475.0",
    "pdf-parse": "^1.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.35.5",
    "sql.js": "^1.15.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^34.2.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^3.0.5"
  },
  "build": {
    "appId": "com.vincent.radialfilestudio",
    "productName": "Radial File Studio",
    "copyright": "Copyright © 2026 Vincent",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "**/node_modules/sharp/**/*",
      "**/node_modules/@img/**/*",
      "**/node_modules/sql.js/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Radial File Studio"
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}.${ext}"
    }
  }
}
